# Import Libraries
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import os
from astropy import units as u
from spectral_cube import SpectralCube
from astropy.coordinates import SkyCoord
from astropy.io import fits
from astropy.modeling import models, fitting

# Ignore the warnings
import warnings
from spectral_cube.wcs_utils import WCSWarning
warnings.filterwarnings("ignore", category=WCSWarning)

# Define info about target
cube_file_path = '/home/polaris/nitrogen_haro11/data/haro11/Haro11_ec_all.rc.fits'


# Define point of spectrum
centerCoords = [(267, 216), (319, 62), (241, 188)]
radius_pixels = 0.1/0.025


# Open the cube
file = fits.open(cube_file_path)
cube = SpectralCube.read(file[1])

# Spectral axis
spectral_axis = cube.spectral_axis.to_value(u.AA)


bin_width = 125.0  # Å
wave_min = spectral_axis.min()
wave_max = spectral_axis.max()

# Create non-overlapping bins
bin_edges = np.arange(wave_min, wave_max + bin_width, bin_width)

fwhm = []
fwhm_wavelengths = []


for point in centerCoords:

    # Point values
    point_fwhm = []
    point_fwhm_wavelengths = []


    # Define the circular mask for each point
    center_x = point[0]
    center_y = point[1]
    
    ny, nx = cube.shape[1], cube.shape[2]
    y, x = np.indices((ny, nx))
    circle_mask = (x - center_x)**2 + (y - center_y)**2 <= radius_pixels**2

    # For each bin, fit the center with a 2DMoffat and obtain the FWHM
    for bin_start, bin_end in zip(bin_edges[:-1], bin_edges[1:]):

        # Skip bins that contain the 5870–6050 Å gap
        if bin_start < 6050 and bin_end > 5870:
            print(f"Skipping {bin_start:.1f} - {bin_end:.1f} Å (gap)")
            continue

        # Find channels inside this wavelength bin
        bin_mask = (
            (spectral_axis >= bin_start) &
            (spectral_axis < bin_end)
        )

        bin_indices = np.where(bin_mask)[0]

        if len(bin_indices) == 0:
            continue

        # Central wavelength
        central_wavelength = (bin_start + bin_end) / 2

        print(f"{bin_start:.1f} - {bin_end:.1f} Å")

        # Get all channels in the bin
        subcube = cube[bin_indices[0]:bin_indices[-1] + 1, :, :]

        # Create the 2D integrated image
        image = subcube.moment(order=0).value

        # Apply circular mask
        x_fit = x[circle_mask]
        y_fit = y[circle_mask]
        z_fit = image[circle_mask]

        # Remove NaN/inf values
        valid = np.isfinite(z_fit)
        x_fit = x_fit[valid]
        y_fit = y_fit[valid]
        z_fit = z_fit[valid]

        # Skip invalid images
        if len(z_fit) < 10:
            continue

        amplitude = np.nanmax(z_fit)

        if not np.isfinite(amplitude) or amplitude <= 0:
            continue

        model_init = models.Moffat2D(
            amplitude=amplitude,
            x_0=center_x,
            y_0=center_y,
            gamma=1.0,
            alpha=1.0
        )

        fitter = fitting.LevMarLSQFitter()

        try:
            fitted_model = fitter(
                model_init,
                x_fit,
                y_fit,
                z_fit,
                filter_non_finite=True
            )

            fwhm_pixels = fitted_model.fwhm
            fwhm_arcseconds = fwhm_pixels * 0.025

            if np.isfinite(fwhm_arcseconds):
                point_fwhm_wavelengths.append(central_wavelength)
                point_fwhm.append(fwhm_arcseconds)

        except Exception as e:
            print(f"Fit failed at {central_wavelength:.2f} Å: {e}")

    fwhm.append(point_fwhm)
    fwhm_wavelengths.append(point_fwhm_wavelengths)


# Print the average of the results
average_fwhm = np.mean(np.concatenate(fwhm))

print("Average:", average_fwhm)


# Plot figure
plt.figure(figsize=(10, 5))

for wavelengths, values in zip(fwhm_wavelengths, fwhm):
    plt.plot(
        wavelengths,
        values,
        linestyle='none',
        marker='o',
        markersize=5
    )

plt.xlabel('Observed wavelength (Å)')
plt.ylabel('Moffat FWHM (arcsec)')
plt.grid(alpha=0.2)
plt.tight_layout()

plt.savefig('/home/polaris/nitrogen_haro11/data/fwhm_wave.png')

plt.show()